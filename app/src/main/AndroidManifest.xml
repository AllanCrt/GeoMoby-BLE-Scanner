<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE hardware requirement -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- ============================================================ -->
    <!-- Permissions: Version-aware BLE + Foreground Service          -->
    <!-- ============================================================ -->

    <!-- Legacy Bluetooth permissions (Android 11 and below) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
        Location permission required for BLE scanning:
        - Android 6–11: Required for BLE scanning API to return results.
        - Android 12+: Still required because we do NOT use the neverForLocation flag
          on BLUETOOTH_SCAN. iBeacon UUID/major/minor are location-identifying data,
          so omitting neverForLocation is the technically correct approach.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
        Android 12+ (API 31): Granular Bluetooth permissions.
        NOTE: We intentionally do NOT set usesPermissionFlags="neverForLocation"
        because iBeacon data is fundamentally location data.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Foreground Service (required on Android 8+ for startForeground) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Android 14+: Must declare specific foreground service type permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Android 13+: Runtime notification permission for foreground service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BleScannerApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BLEScanner"
        tools:targetApi="35">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BLEScanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            BLE Scanning Foreground Service.
            foregroundServiceType="connectedDevice" is mandatory on Android 14+
            for any service that interacts with Bluetooth devices.
        -->
        <service
            android:name=".service.BleScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
